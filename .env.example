# Copy this file to .env.production on the CPD server and edit local paths.
# Do not commit .env.production.

# Host paths on the CPD server.
RAW_HOST_DIR=/mnt/RAW/UGR
PRODUCTS_HOST_DIR=/mnt/PRODUCTS/UGR
INFO_SCC_CONFIG_HOST_PATH=/opt/gfat-worker/info_scc_user.yml

# Bind API only to localhost unless it is behind a controlled reverse proxy.
API_BIND=127.0.0.1
API_PORT=8000

# Flower is optional and only enabled with: docker compose --profile ops ...
FLOWER_BIND=127.0.0.1
FLOWER_PORT=5555

# Docker image name used by compose.prod.yml.
GFAT_WORKER_IMAGE=gfat-worker:local

# Celery.
CELERY_BEAT_ENABLED=true
CELERY_LOG_LEVEL=info
